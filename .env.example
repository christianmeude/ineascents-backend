APP_NAME="Inea Scents"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# 12-Factor: per-env URL — no fallback in code. Local uses 127.0.0.1:8080, prod uses the Render URL.
APP_URL=http://127.0.0.1:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database: 12-Factor isolated per env ----
# local: Supabase CLI Postgres (Docker `supabase start`). Ports 54321/54322/54323.
# prod: Supabase Cloud project `ineascents-db` (christianmeude org). Never share with local.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54322
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Alt for cloud: DATABASE_URL=postgresql://postgres.<ref>:<pass>@<host>:5432/postgres

# ---- Session / CORS / Sanctum — per env ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set per env: local=null (host-only), prod=host-only or specific host — never .vercel.app (public suffix blocked)
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# 12-Factor: comma-separated when multiple origins. No default prod fallback in code.
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173
# Landing page origin (Inquiry POSTs). Local: Vite default. Prod: set to the
# deployed landing URL when it ships; local + production only, no staging.
LANDING_URL=http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=false
# Local dev only: regex origin-patterns for CORS; Flutter web uses a random localhost port.
# Must be a delimited PCRE. Shipped default covers any localhost/127.0.0.1 port for local
# dev only — in prod leave empty (exact-match `FRONTEND_URL` only).
CORS_ALLOWED_ORIGIN_PATTERNS=~^http://(localhost|127\.0\.0\.1):\d+$~
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8080,::1
SANCTUM_TOKEN_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# ---- Local mail preview (Mailpit, default) ----
# Run the Mailpit binary (standalone, no container): SMTP on 1025, web UI on
# http://127.0.0.1:8025. Mail never leaves the machine — zero inbox burn.
# See docs/ops/env-setup-runbook.md (Local: Mailpit mail preview).
# ---- Delivery tests + prod Gmail SMTP (values never committed) ----
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=ineascents.app@gmail.com
# MAIL_PASSWORD=<16-letter App Password, spaces removed>
# MAIL_FROM_ADDRESS=ineascents.app@gmail.com
# MAIL_FROM_NAME="Inea Scents"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- PayMongo: never share across envs ----
# local: pk_test_* / sk_test_*  |  prod: pk_live_* / sk_live_*
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
CRON_TOKEN=

# ---- Admin bootstrap (set via Render env for prod; min 12 chars) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@ineascents.com
ADMIN_PASSWORD= # set via env, min 12 chars
